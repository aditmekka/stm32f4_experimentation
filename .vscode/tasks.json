{
    "version": "2.0.0",
    "tasks": [
        {
            // Build the Debug configuration
            "label": "Build Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug"
            ],
            "options": {
                // Ensure CMake can find CMakePresets.json in the project root
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            // Flash the firmware to the STM32 after building
            "label": "Flash Target",
            "type": "shell",
            "command": "openocd",

            // Run "Build Debug" first to avoid flashing an outdated binary
            "dependsOn": "Build Debug",

            "args": [
                // Use a CMSIS-DAP / DAPLink debugger
                "-f",
                "interface/cmsis-dap.cfg",

                // STM32F103C8T6 belongs to the STM32F1 family
                // For STM32F4, H7, etc., replace this with the appropriate target configuration
                "-f",
                "target/stm32f4x.cfg",

                // Flash the ELF file
                // Use a relative path with cwd to avoid OpenOCD issues with Windows backslashes
                // Replace F103C8t6_DiffCar.elf with the actual ELF file generated by your project
                "-c",
                "program build/Debug/TEST1.elf verify reset exit"
            ],
            "options": {
                // Make build/Debug/... relative to the project root directory
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",

                // When true, Ctrl+Shift+B will perform Build + Flash directly
                // Set to false if you want Ctrl+Shift+B to only build by default
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}